# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
ts_errors*.log
/eslint.json
/lint_output.txt
/eslint-errors.txt
/*_routes.txt
/tmp-*.txt
/API_REFACTOR_TASK.txt

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated code
/src/generated/

# local tooling state
/.omx/

# media files (downloaded by app)
/data/media/*
!/data/media/.gitkeep
/public/media/*
server.log
dev-server.log
/logs/
