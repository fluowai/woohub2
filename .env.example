# ==============================================================================
# WOOHUB - TEMPLATE DE CONFIGURACAO (.env)
# ==============================================================================
# Copie este arquivo para .env antes de subir a aplicacao:
#   cp .env.example .env
#
# REGRA: nunca coloque segredos reais neste arquivo versionado.
# Gere segredos com:  openssl rand -base64 32
# ==============================================================================

# ==============================================================================
# 1. CONFIGURACOES OBRIGATORIAS
# ==============================================================================

# Porta do servidor
PORT="3000"

# Conexao com o banco (PostgreSQL gerenciado - Supabase)
# IMPORTANTE:
#   - use o pooler SESSION (porta 5432); a porta 6543 (transacional) TRAVA
#     com o Prisma;
#   - mantenha sslmode=require;
#   - o banco e EXTERNO: nao ha servico de banco na stack Docker.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/postgres?sslmode=require"

# Segredo do NextAuth (obrigatorio; o servidor encerra se ausente em producao)
AUTH_SECRET="REPLACE_ME_WITH_openssl_rand_-base64_32"

# Chave de criptografia das credenciais WhatsApp (AES-256-GCM).
# OBRIGATORIO em producao. Fica apenas no ambiente - nunca no banco nem no Git.
# Rotacao: mova a chave atual para CREDENTIALS_ENCRYPTION_KEY_PREVIOUS e gere uma nova.
CREDENTIALS_ENCRYPTION_KEY="REPLACE_ME_WITH_openssl_rand_-base64_32"
CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=""

# URL publica da aplicacao
BASE_URL="http://localhost:3000"

# Ambiente (development | production | test)
NODE_ENV="development"
DEPLOYMENT_MODE="CENTRAL"

# Hostname de bind
HOSTNAME="localhost"


# ==============================================================================
# 2. NEXTAUTH & PROXY
# ==============================================================================

NEXTAUTH_URL="${BASE_URL}"
AUTH_TRUST_HOST="true"

NEXT_PUBLIC_APP_URL="${BASE_URL}"
NEXT_PUBLIC_API_URL="${BASE_URL}/api"


# ==============================================================================
# 3. MARCA
# ==============================================================================

APP_NAME="Woohub"
LOGO_URL=""
FAVICON_URL=""

NEXT_PUBLIC_CHAT_PAGE_SIZE="50"
NEXT_PUBLIC_ALLOW_INDEXING="false"


# ==============================================================================
# 4. DOCUMENTACAO API
# ==============================================================================
# Sem credenciais dedicadas: /swagger exige sessao do painel (validada no
# proxy) e a spec (/api/docs, /api/v1/openapi.json) nao contem dados de tenant
# nem segredos. NUNCA use variaveis NEXT_PUBLIC_* para guardar segredos.


# ==============================================================================
# 5. NUCLEO WHATSAPP (motor Baileys)
# ==============================================================================

# fatal | error | warn | info | debug | trace
BAILEYS_LOG_LEVEL="error"


# ==============================================================================
# 6. INTEGRACOES & FLAGS
# ==============================================================================

REMOVE_BG_API_KEY=""
ENABLE_NOTIFICATIONS="true"
ENABLE_AUTO_UPDATE_CHECK="false"
ENABLE_EXPERIMENTAL_FEATURES="false"


# ==============================================================================
# 7. SEGURANCA & LIMITES
# ==============================================================================

SESSION_TIMEOUT_HOURS="24"

# MFA TOTP (RFC 6238). "true" exige que MEGA_ADMIN/SUPERADMIN tenham MFA
# habilitado no perfil antes de conseguir entrar. Ative SOMENTE depois de todos
# os administradores cadastrarem o autenticador (caso contrario sera bloqueado).
MFA_REQUIRED_FOR_ADMINS="false"

# Tamanho maximo de upload (MB)
MAX_UPLOAD_SIZE_MB="50"

# Rate limit por credencial (chave de API ou IP) em requisicoes/minuto
RATE_LIMIT_PER_MINUTE="120"

# "true" SOMENTE quando um reverse proxy (Traefik/nginx) fica na frente e
# sobrescreve X-Forwarded-For. Com "false" (padrao), o XFF do cliente e
# ignorado para o rate limit/identidade (anti-spoof).
TRUST_PROXY="false"

# Protecao contra abuso de login/cadastro
AUTH_RATE_LIMIT_PER_15MIN="10"
REGISTER_RATE_LIMIT_PER_HOUR="5"

# Origens permitidas para o Socket.IO (separadas por virgula).
# Nunca use "*".
SOCKET_ALLOWED_ORIGINS="http://localhost:3000"

# Webhooks: tentativas, timeout e retencao de logs de entrega
WEBHOOK_MAX_ATTEMPTS="3"
WEBHOOK_TIMEOUT_MS="10000"
WEBHOOK_LOG_RETENTION_DAYS="30"

# Retencao automatizada (expurgo diario, ver docs/RETENTION.md)
# Jobs terminais (SUCCEEDED/FAILED/CANCELED/DEAD) mais antigos que N dias.
JOB_RETENTION_DAYS="30"
# Mensagens (0 = desabilitado; defina um valor só se aceitar expurgo de historico).
MESSAGE_RETENTION_DAYS="0"

# Alertas operacionais (opcional): URL de webhook JSON (Slack/Discord/Telegram
# compativel) que recebe alertas de boot, shutdown, uncaughtException, banco
# indisponivel e crescimento da DLQ. Nunca envia dados de clientes.
ALERT_WEBHOOK_URL=""


# ==============================================================================
# 8. TELEMETRIA EXTERNA (OPCIONAL - DESATIVADA POR PADRAO)
# ==============================================================================
# O heartbeat externo e opcional e esta DESLIGADO por padrao.
# Quando ligado, envia apenas: nome/produto, versao, URL de implantacao,
# plataforma, versao do Node e memoria RSS em MB.
# NAO envia dados de clientes, tenants, credenciais, QR codes ou mensagens.
TELEMETRY_ENABLED="false"
# TELEMETRY_URL="https://api-wa-akg.aikeigroup.net/api/ping"


# ==============================================================================
# 9. LOCALIZACAO & ARMAZENAMENTO
# ==============================================================================

TZ="America/Sao_Paulo"
LOCALE="pt-BR"

# Caminho fixo de uploads no disco (data/media). Informativo: o codigo usa
# sempre <cwd>/data/media — em Docker isso e o volume app_data:/app/data.
MEDIA_STORAGE_PATH="data/media"

NEXT_PUBLIC_GA_ID=""


# ==============================================================================
# 10. DOCKER (docker-compose.yml / docker-stack.yml)
# ==============================================================================
# Necessarios ao subir via docker-compose.yml ou docker-stack.yml
# (stack compose de producao = woo-woohub; ver docs/DEPLOY.md).
# As stacks NAO sobem banco: DATABASE_URL (secao 1) e obrigatorio e deve
# apontar para o PostgreSQL externo (Supabase) com sslmode=require.

# Tag IMAGEM fixa usada pela app e pelo job de migracao (nunca "latest")
WOHUB_TAG="1.6.4"

# Criacao UNICA do administrador: executada APENAS pelo job de migracao
# (scripts/migrate.sh), nunca no boot da aplicacao. O script nao recria nem
# re-promove usuarios existentes.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="REPLACE_ME"

# ==============================================================================
# 11. LICENCA (OBRIGATORIA PARA SUBIR O CONTAINER)
# ==============================================================================
# SEM LICENSE_KEY os stacks docker-compose.yml e docker-stack.yml abortam o
# deploy na interpolacao (`:?`) — no Portainer as tarefas nem chegam a ser
# criadas. COM a chave presente mas invalida, o gate da porta de entrada
# (scripts/license-entrypoint.ts) sai com codigo 1: container `Exited (1)` /
# servico `Failed` (0 de 1), nunca Running.
#
# Formato 1 — RECOMENDADO (assinatura Ed25519, verificacao 100% offline,
# nao depende do banco, funciona no primeiro deploy de uma base vazia):
#   WOHUB1.<payload base64url>.<assinatura base64url>
#   Emissao (somente no servidor do fornecedor, com a chave privada):
#     npx tsx scripts/license-sign.ts --genkey
#     npx tsx scripts/license-sign.ts --sign --priv "$LICENCA_PRIV_KEY" \
#       --sub "Cliente X" --type PROFESSIONAL --days 365 --max-instances 3
#
# Formato 2 — legado (chave opaca, validada na tabela `License` do banco;
# o registro precisa existir ANTES do boot — em base nova use o formato 1):
#   WOHUB-XXXX-XXXX-XXXX-XXXX
LICENSE_KEY=""

# Public key Ed25519 do par gerado por `license-sign.ts --genkey`
# (SPKI base64 ou PEM). OBRIGATORIA quando LICENSE_KEY comecar com "WOHUB1".
# Alternativa: gravar o PEM em scripts/license.pub dentro da imagem.
LICENSE_PUBLIC_KEY=""

# Host publico da app; usado apenas quando a chave emitida declara a claim
# `domain` (a licenca so vale para esse host).
LICENSE_DOMAIN=""

# URL do servidor central de licenciamento (ex.: https://api.woohub.app).
# Quando preenchida, o container valida suspensao/revogacao online no boot.
LICENSE_SERVER_URL=""

# Imagem Docker de producao (GitHub Container Registry privado ou Docker Hub).
# No Portainer, requer autenticacao previa no menu Registries com token read:packages.
DOCKER_IMAGE="ghcr.io/woohub/app"

# Horas de carencia apos expiracao (padrao: 24h)
LICENSE_GRACE_PERIOD_HOURS="24"


# ==============================================================================
# 12. COBRANCA (GATEWAY DE PAGAMENTOS)
# ==============================================================================

# GitHub owner/repo for auto-update checks (optional)
GITHUB_OWNER="woohub"
GITHUB_REPO="woohub"

# Sem gateway configurado, o checkout responde 503 gateway_not_configured e a
# ativacao de assinaturas e manual e auditada (modo piloto).
# A ativacao por gateway so ocorre apos:
#   1) validacao da assinatura HMAC do webhook (PAYMENT_WEBHOOK_SECRET) e
#   2) confirmacao server-to-server do pagamento no gateway.
# NUNCA coloque o valor real destas variaveis em arquivos versionados.
PAYMENT_GATEWAY=""            # ex.: "mercadopago" | "" (sem gateway)
PAYMENT_GATEWAY_PUBLIC_KEY=""
PAYMENT_GATEWAY_SECRET_KEY="" # token de acesso do gateway (obrigatorio para mercadopago)
PAYMENT_WEBHOOK_SECRET=""     # secret de assinatura do webhook (obrigatorio para mercadopago)
PAYMENT_GATEWAY_SANDBOX=""    # "true" usa o checkout sandbox FORA de producao
