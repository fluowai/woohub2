// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEGA_ADMIN
  SUPER_ADMIN
  SUPERADMIN
  OWNER
  STAFF
}

enum ResellerStatus {
  ACTIVE
  SUSPENDED
  CANCELED
}

enum DomainType {
  PLATFORM
  RESELLER
}

enum CommercialMode {
  DIRECT
  RESELLER
  WHITE_LABEL
}

enum DomainStatus {
  PENDING_VERIFICATION
  VERIFIED
  ACTIVE
  FAILED
  SUSPENDED
}

enum CertStatus {
  PENDING
  ISSUED
  FAILED
  EXTERNAL
}

// Tenant-scoped roles. Platform role stays on User.role (SUPERADMIN = platform admin).
enum TenantRole {
  OWNER
  ADMIN
  STAFF
  BILLING
  USER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
  EXPIRED
}

enum InvoiceStatus {
  OPEN
  PENDING
  PAID
  VOID
  REFUNDED
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
  DEAD
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
  LOCATION
  CONTACT
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(OWNER)
  apiKey    String?  @unique // DEPRECATED: legacy plaintext key. Migrated to ApiKey (hashed) and never rewritten.
  // MFA TOTP (RFC 6238). Secret is AES-256-GCM encrypted at rest (src/lib/mfa.ts).
  mfaEnabled Boolean @default(false)
  mfaSecret  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  sessions  Session[]
  webhooks  Webhook[]
  notifications Notification[]
  sessionAccesses SessionAccess[]
  memberships TenantMember[]
  apiKeysCreated ApiKey[] @relation("ApiKeyCreator")
  resellersOwned Reseller[] @relation("ResellerOwner")
  stackTemplates StackTemplate[]
}

// A company/workspace. All customer resources are isolated by tenant.
model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  status    String   @default("ACTIVE") // ACTIVE, SUSPENDED, CLOSED
  commercialMode CommercialMode @default(DIRECT)
  resellerId String? // null = direct client of Mega Admin; non-null = client of a reseller
  maxInstances Int   @default(1)
  features  Json?    // Enabled features
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reseller      Reseller?            @relation(fields: [resellerId], references: [id], onDelete: SetNull)
  instanceAllocations InstanceAllocation[]
  members       TenantMember[]
  apiKeys       ApiKey[]
  sessions      Session[]
  webhooks      Webhook[]
  subscriptions Subscription[]
  invoices      Invoice[]
  usage         UsageCounter[]
  auditLogs     AuditLog[]
  messageJobs   MessageJob[]

  @@index([status])
  @@index([resellerId])
}

model TenantMember {
  id        String     @id @default(cuid())
  tenantId  String
  userId    String
  role      TenantRole @default(STAFF)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

// Client-facing API keys. Only the hash is stored; the secret is shown once at creation.
model ApiKey {
  id          String    @id @default(cuid())
  tenantId    String
  publicId    String    @unique // public prefix used for identification/rotation (never a secret)
  name        String
  hash        String    @unique // sha256(full key)
  scopes      String    @default("instances:read instances:write messages:read messages:send contacts:read webhooks:read webhooks:write")
  instanceId  String?   // optional binding to a single Session.sessionId
  expiresAt   DateTime?
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, revokedAt])
}

model Plan {
  id             String   @id @default(cuid())
  code           String   @unique
  commercialMode CommercialMode @default(DIRECT)
  name           String
  description    String?  @db.Text
  priceCents     Int      @default(0)
  currency       String   @default("BRL")
  period         String   @default("MONTHLY") // MONTHLY, YEARLY, ONE_TIME
  maxInstances   Int      @default(1)
  maxUsers       Int      @default(1)
  requestLimit   Int      @default(1000) // requests per period
  sendLimit      Int      @default(500)  // outbound messages per period
  storageLimitMb Int      @default(100)
  retentionDays  Int      @default(30)
  maxInstallations Int   @default(0) // 0 = not applicable; never means unlimited
  trialDays      Int      @default(0)
  gracePeriodDays Int     @default(0)
  features       Json?    // enabled feature flags
  status         String   @default("ACTIVE") // ACTIVE, ARCHIVED
  sort           Int      @default(0)
  resellerId     String?  // null = platform plan; non-null = resale plan
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reseller      Reseller?      @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([status])
  @@index([resellerId])
}

model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String?
  resellerId         String?            // subscription between reseller and mega admin
  planId             String
  commercialMode     CommercialMode @default(DIRECT)
  contractedMaxInstances Int?
  contractedMaxUsers Int?
  contractedMaxInstallations Int?
  termsVersion       String?
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  canceledAt         DateTime?
  suspendedAt        DateTime?
  graceEndsAt        DateTime? // configurable tolerance window
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reseller Reseller? @relation("ResellerSubscriptions", fields: [resellerId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@unique([tenantId])
  @@index([resellerId])
  @@index([status])
}

model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  subscriptionId String?
  number         String        @unique
  amountCents    Int
  currency       String        @default("BRL")
  status         InvoiceStatus @default(OPEN)
  dueAt          DateTime?
  paidAt         DateTime?
  externalId     String?       @unique // gateway charge id
  description    String?       @db.Text
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
}

// Provider-agnostic payment events. externalEventId unique => webhook deduplication.
model PaymentEvent {
  id              String             @id @default(cuid())
  gateway         String             // e.g. "manual", "stripe", "mercadopago"
  externalEventId String             @unique
  type            String             // payment.succeeded, charge.refunded, ...
  payload         Json?
  status          PaymentEventStatus @default(RECEIVED)
  invoiceId       String?
  error           String?            @db.Text
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?

  @@index([status, receivedAt])
}

// Per-period usage counters (counted once, at the point of acceptance).
model UsageCounter {
  id        String   @id @default(cuid())
  tenantId  String
  periodKey String   // e.g. "2026-10" (billing period key)
  metric    String   // "requests", "messages_sent", "instances"
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodKey, metric])
  @@index([tenantId, periodKey])
}

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String?
  resellerId   String?
  actorUserId  String?
  actorLabel   String   // user email, api key publicId, or "system"
  actorType    String   @default("USER") // USER, API_KEY, SYSTEM
  action       String   // e.g. "session.create", "superadmin.access"
  resource     String?
  resourceId   String?
  metadata     Json?
  ip           String?
  requestId    String?
  createdAt    DateTime @default(now())

  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reseller Reseller? @relation(fields: [resellerId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([resellerId, createdAt])
  @@index([action, createdAt])
}

// Durable outbound job queue (transactional DB queue; single-replica MVP).
model MessageJob {
  id            String    @id @default(cuid())
  tenantId      String
  sessionPk     String    // Session.id (CUID)
  instanceId    String    // Baileys sessionId
  type          String    @default("send_message")
  payload       Json
  status        JobStatus @default(PENDING)
  priority      Int       @default(100)
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3)
  availableAt   DateTime  @default(now())
  lockedAt      DateTime?
  lockedBy      String?
  correlationId String?
  lastError     String?   @db.Text
  resultKey     String?   // WhatsApp message key id when accepted by the engine
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([instanceId, status, availableAt])
  @@index([tenantId, createdAt])
  @@index([correlationId])
}

// Idempotency records for public API write operations.
model IdempotencyRecord {
  id            String   @id @default(cuid())
  tenantId      String
  endpoint      String
  key           String
  requestHash   String
  status        String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  responseCode  Int?
  responseBody  Json?
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  @@unique([tenantId, endpoint, key])
  @@index([expiresAt])
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  tenantId    String? // company that owns this instance (backfilled by scripts/migrate-tenancy.js)
  name        String    // e.g. "Marketing WA"
  sessionId   String    @unique // The unique ID used for Baileys auth
  status      String    @default("DISCONNECTED") // STOPPED, CONNECTING, QR_REQUIRED, CONNECTED, DISCONNECTED, LOGGED_OUT, ERROR, ZOMBIE, SCAN_QR, NUMBER_MISMATCH
  qr          String?   @db.Text
  linkedPhone String?   // digits-only number this instance is allowed to connect with
  mismatchPhone String? // last scanned number that did not match linkedPhone
  config      Json?     // Store instance specific config (e.g. "read_receipts": true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contacts    Contact[]
  messages    Message[]
  groups      Group[]
  autoReplies AutoReply[]
  stories     Story[]
  scheduledMessages ScheduledMessage[]
  webhooks    Webhook[]
  botConfig   BotConfig?
  sessionAccesses SessionAccess[]

  @@index([tenantId])
}

model Contact {
  id          String   @id @default(cuid())
  sessionId   String
  jid         String   // remoteJid (123456@s.whatsapp.net)
  lid         String?  // LID JID
  name        String?
  notify      String?  // Pushname
  verifiedName String? // Business Name
  remoteJidAlt String? // Alternate JID (e.g. Phone if JID is LID)
  profilePic  String?  @db.Text
  data        Json?    // Detailed contact data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([sessionId, jid])
}

model Message {
  id          String        @id @default(cuid())
  sessionId   String
  remoteJid   String        // Receiver or Group Jid
  senderJid   String?       // If group, who sent it. If private, same as remoteJid (incoming) or me (outgoing)
  fromMe      Boolean
  keyId       String        // WhatsApp Message Key ID
  pushName    String?
  type        MessageType   @default(TEXT)
  content     String?       @db.Text // Text content or Caption
  mediaUrl    String?       @db.Text // Path to file if media
  status      MessageStatus @default(PENDING)
  timestamp   DateTime      @default(now())
  
  quoteId     String?       // For replies
  
  contactId   String?
  contract    Contact?      @relation(fields: [contactId], references: [id])
  session     Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, keyId])
  @@index([sessionId, remoteJid])
  @@index([sessionId, remoteJid, timestamp])
}

model Group {
  id          String   @id @default(cuid())
  sessionId   String
  jid         String
  subject     String?
  description String?  @db.Text
  ownerJid    String?
  participants Json?   // Stored as JSON for now: [{id: '123@s.whatsapp.net', admin: 'admin' | null}]
  creation    DateTime?
  restrict    Boolean? // Only admins can edit group info
  announce    Boolean? // Only admins can send messages
  
  metadata    Json?    // Raw full metadata dump
  
  inviteCode  String?
  
  // Community Features
  isCommunity Boolean  @default(false)
  linkedParentJid String? // JID of the community parent group if it belongs to one
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, jid])
}

model AutoReply {
  id          String   @id @default(cuid())
  sessionId   String
  keyword     String
  matchType   String   // EXACT, CONTAINS, REGEX
  response    String?  @db.Text
  isMedia     Boolean  @default(false)
  mediaUrl    String?
  mediaType   String?
  triggerType String   @default("ALL") // ALL, GROUP, PRIVATE
  createdAt   DateTime @default(now())

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Story {
  id          String   @id @default(cuid())
  sessionId   String
  jid         String   // User who posted the story or Broadcast JID
  content     String?  @db.Text
  mediaUrl    String?  @db.Text
  type        String   // IMAGE, VIDEO, TEXT
  timestamp   DateTime @default(now())
  viewed      Boolean  @default(false)

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model ScheduledMessage {
  id          String   @id @default(cuid())
  sessionId   String
  jid         String
  content     String?  @db.Text
  mediaUrl    String?
  mediaType   String?  // image, video, document, etc.
  sendAt      DateTime
  cronExpression String? // e.g., '*/5 * * * *'
  recurrenceRule String? @db.Text // UI JSON state
  status      String   @default("PENDING") // PENDING, SENT, FAILED
  createdAt   DateTime @default(now())

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// Store for Baileys MultiFileAuthState (in DB)
model AuthState {
  id        String   @id @default(cuid())
  sessionId String
  key       String   // Filename/Key (creds.json, etc)
  value     Json
  
  @@unique([sessionId, key])
}

// Webhook configuration for external event notifications
model Webhook {
  id          String   @id @default(cuid())
  userId      String
  tenantId    String? // company that owns this webhook
  sessionId   String?  // Optional: specific session, null = all sessions
  name        String   // e.g. "My Server Webhook"
  url         String   // The webhook endpoint URL
  secret      String?  // Optional secret for HMAC signing
  events      Json     // Array of event types: ["message.received", "message.sent", "connection.update", etc.]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session     Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  logs        WebhookLog[]

  @@index([tenantId])
}

// Webhook delivery logs — tracks every webhook request attempt
model WebhookLog {
  id                 String   @id @default(cuid())
  webhookId          String
  event              String   // The event that triggered this webhook
  eventId            String?  // Unique delivery/event id (deduplication + consumer idempotency)
  attempt            Int      @default(1)
  status             String   // SUCCESS, FAILED, PENDING (retry scheduled)
  nextAttemptAt      DateTime?
  requestUrl         String   @db.Text
  requestHeaders     Json?
  requestBody        Json?
  responseStatusCode Int?
  responseBody       String?  @db.Text
  responseTimeMs     Int?
  errorMessage       String?  @db.Text
  createdAt          DateTime @default(now())

  webhook            Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([webhookId, createdAt])
  @@index([eventId])
}

enum AccessMode {
  ALL
  OWNER
  SPECIFIC
  BLACKLIST
}

model BotConfig {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  enabled       Boolean  @default(true)
  
  // Bot Command Access
  botName       String   @default("WooHub Bot")
  botMode       AccessMode @default(OWNER)
  botAllowedJids Json?     // Array of JIDs ["628123@s.whatsapp.net"]
  botBlockedJids Json?     // Array of JIDs ["628123@s.whatsapp.net"] for BLACKLIST mode

  // Auto Reply Access
  autoReplyMode AccessMode @default(ALL)
  autoReplyAllowedJids Json?
  autoReplyBlockedJids Json? // Array of JIDs for BLACKLIST mode

  enableSticker Boolean  @default(true)
  enableVideoSticker Boolean @default(true)
  maxStickerDuration Int @default(10) // in seconds
  enablePing    Boolean  @default(true)
  enableUptime  Boolean  @default(true)
  removeBgApiKey String?
  prefix        String   @default("#")
  
  // Anti-Spam / Rate Limit
  antiSpamEnabled Boolean @default(false)
  spamLimit       Int     @default(5)    // Messages allowed in window
  spamInterval    Int     @default(10)   // Seconds window
  spamDelayMin    Int     @default(1000) // MS min delay
  spamDelayMax    Int     @default(3000) // MS max delay

  // Automation & Presence
  welcomeMessage  String? @db.Text
  autoRead        Boolean @default(false)
  alwaysOnline    Boolean @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SystemConfig {
  id                 String   @id @default("default") // Singleton ID
  appName            String   @default("Woohub")
  logoUrl            String?
  faviconUrl         String?
  timezone           String   @default("America/Sao_Paulo")
  enableRegistration Boolean  @default(true)
  // External telemetry (heartbeat). Off by default; never contains customer data.
  telemetryEnabled   Boolean  @default(false)
  telemetryUrl       String?
  
  updatedAt          DateTime @updatedAt
}

// Labels/Tags for organizing chats
model Label {
  id          String      @id @default(cuid())
  sessionId   String
  name        String
  color       Int         @default(0) // 0-19 for WhatsApp color codes
  colorHex    String      @default("#FF0000") // Hex representation
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  chatLabels  ChatLabel[]
  
  @@unique([sessionId, name]) // Unique label name per session
  @@index([sessionId])
}

// Many-to-many relationship between chats and labels
model ChatLabel {
  id        String   @id @default(cuid())
  labelId   String
  chatJid   String   // The JID of the chat
  createdAt DateTime @default(now())
  
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)
  
  @@unique([labelId, chatJid]) // Prevent duplicate label assignments
  @@index([chatJid])
  @@index([labelId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   @default("INFO") // INFO, WARNING, SUCCESS, SYSTEM
  read      Boolean  @default(false)
  href      String?
  
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Shared session access — allows session owners to grant access to other users
model SessionAccess {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  createdAt DateTime @default(now())

  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
  @@index([sessionId])
}

// Broadcast/Blast history & logs
model BroadcastLog {
  id          String              @id @default(cuid())
  sessionId   String              // WA session ID string
  message     String              @db.Text
  total       Int
  sent        Int                 @default(0)
  failed      Int                 @default(0)
  status      String              @default("running") // running, completed, cancelled
  delay       Int                 @default(2000)
  startedAt   DateTime            @default(now())
  completedAt DateTime?

  recipients  BroadcastRecipient[]

  @@index([sessionId])
  @@index([sessionId, startedAt])
}

model BroadcastRecipient {
  id              String       @id @default(cuid())
  broadcastLogId  String
  jid             String
  status          String       @default("pending") // pending, sent, failed
  error           String?      @db.Text
  sentAt          DateTime?

  broadcastLog    BroadcastLog @relation(fields: [broadcastLogId], references: [id], onDelete: Cascade)

  @@index([broadcastLogId])
}

model PlatformConfig {
  id                  String   @id @default("default") // Singleton ID
  platformName        String   @default("Woohub")
  primaryDomain       String?  @default("woohub.local")
  supportEmail        String?  @default("suporte@woohub.local")
  enableRegistration  Boolean  @default(true)
  defaultFeatures     Json?
  maxResellers        Int?     @default(100)
  globalWebhookSecret String?
  gatewayConfig       Json?
  updatedAt           DateTime @updatedAt
}

model Reseller {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  ownerId             String
  status              ResellerStatus       @default(ACTIVE)
  commercialMode      CommercialMode       @default(RESELLER)
  maxInstances        Int                  @default(10)
  maxTenants          Int                  @default(20)
  maxUsers            Int                  @default(50)
  features            Json?
  storageLimitMb      Int                  @default(1024)
  retentionDays       Int                  @default(30)
  customDomainAllowed Boolean              @default(false)
  notes               String?              @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  owner               User                 @relation("ResellerOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  branding            Branding?
  domains             Domain[]
  tenants             Tenant[]
  plans               Plan[]
  subscriptions       Subscription[]       @relation("ResellerSubscriptions")
  instanceAllocations InstanceAllocation[]
  auditLogs           AuditLog[]
  installations       Installation[]
  licenses            License[]

  @@index([status])
  @@index([ownerId])
}

model InstanceAllocation {
  id            String   @id @default(cuid())
  resellerId    String
  tenantId      String
  allocated     Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reseller      Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([resellerId, tenantId])
  @@index([resellerId])
  @@index([tenantId])
}

model Domain {
  id                 String       @id @default(cuid())
  hostname           String       @unique
  type               DomainType   @default(RESELLER)
  resellerId         String?
  status             DomainStatus @default(PENDING_VERIFICATION)
  verificationToken  String
  verificationMethod String       @default("DNS_TXT")
  certificateStatus  CertStatus   @default(PENDING)
  validatedAt        DateTime?
  dnsInstructions    Json?
  history            Json?
  notes              String?      @db.Text
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  reseller           Reseller?    @relation(fields: [resellerId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([resellerId])
}

model Branding {
  id              String   @id @default(cuid())
  resellerId      String   @unique
  name            String
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String   @default("#ff5a00")
  secondaryColor  String   @default("#0f172a")
  accentColor     String   @default("#f97316")
  supportEmail    String?
  supportPhone    String?
  commercialLinks Json?
  docBrandName    String?
  customCss       String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  reseller        Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  REVOKED
  PENDING
}

enum LicenseType {
  TRIAL
  STANDARD
  PROFESSIONAL
  ENTERPRISE
  RESELLER
}

enum StackTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InstallationStatus {
  DRAFT
  RESERVED
  PREPARED
  ACTIVATING
  ACTIVE
  DEGRADED
  OFFLINE
  LICENSE_RESTRICTED
  RETIRED
}

enum InstallationMode {
  COMPOSE
  SWARM
}

model License {
  id              String        @id @default(cuid())
  licenseKey      String        @unique // Format: WOHUB-XXXX-XXXX-XXXX-XXXX
  status          LicenseStatus @default(PENDING)
  type            LicenseType   @default(TRIAL)
  commercialMode  CommercialMode @default(WHITE_LABEL)
  resellerId      String?
  issuedTo        String        // Company/Reseller name
  issuedToEmail   String        // Contact email
  maxInstances    Int           @default(1)
  maxTenants      Int           @default(1)
  maxUsers        Int           @default(5)
  maxResellers    Int           @default(0)
  features        Json?         // Enabled features list
  issuedAt        DateTime      @default(now())
  expiresAt       DateTime?
  lastValidatedAt DateTime?
  validationCount Int           @default(0)
  revokedAt       DateTime?
  revokedReason   String?
  metadata        Json?         // Additional data (IP, domain, etc)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  validations     LicenseValidation[]
  installations   Installation[]
  reseller        Reseller?      @relation(fields: [resellerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([issuedToEmail])
  @@index([expiresAt])
  @@index([resellerId, status])
}

model StackTemplate {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  description String?            @db.Text
  status      StackTemplateStatus @default(DRAFT)
  edition     String             @default("RESELLER")
  createdById String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  createdBy   User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  versions    StackTemplateVersion[]
  entitlements TemplateEntitlement[]

  @@index([status])
}

model StackTemplateVersion {
  id              String   @id @default(cuid())
  templateId      String
  version         String
  composeYaml     String   @db.Text
  parametersSchema Json
  requirements    Json?
  images          Json?
  healthchecks    Json?
  migrationNotes  String?  @db.Text
  publishedAt     DateTime?
  createdAt       DateTime @default(now())

  template        StackTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  installations   Installation[]

  @@unique([templateId, version])
  @@index([templateId, publishedAt])
}

model TemplateEntitlement {
  id          String   @id @default(cuid())
  templateId  String
  licenseType LicenseType
  createdAt   DateTime @default(now())

  template    StackTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, licenseType])
}

model Installation {
  id                 String             @id @default(cuid())
  resellerId         String
  licenseId          String
  templateVersionId  String
  name               String
  domain             String?
  mode               InstallationMode
  status             InstallationStatus @default(DRAFT)
  capacity           Int                @default(1)
  bootstrapHash      String?            @unique
  bootstrapExpiresAt DateTime?
  installationKeyHash String?           @unique
  activationNonce    String?
  protocolVersion    Int                @default(1)
  licenseRevision    Int                @default(1)
  reportedInstances  Int                @default(0)
  reportedConnected  Int                @default(0)
  reportedState      String?
  reportedVersion    String?
  lastHeartbeatAt    DateTime?
  transferRequestedAt DateTime?
  activatedAt        DateTime?
  lastContactAt      DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  reseller           Reseller           @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  license            License            @relation(fields: [licenseId], references: [id], onDelete: Restrict)
  templateVersion    StackTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)

  @@index([resellerId, status])
  @@index([licenseId])
  @@index([lastContactAt])
}

model LicenseValidation {
  id          String   @id @default(cuid())
  licenseId   String
  ip          String?
  domain      String?
  userAgent   String?
  success     Boolean  @default(true)
  error       String?
  createdAt   DateTime @default(now())

  license     License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
  @@index([createdAt])
}

